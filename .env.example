# agent-runs configuration.
#
# One prefix, RUNS__, with __ between levels — the same shape the Memory Service uses, so an
# operator learns it once. Every value here has a default that works on a laptop; the ones
# that would be wrong in production are called out.
#
# Copy to .env and edit. Never commit .env: it is git-ignored for a reason.

# --- service -----------------------------------------------------------------------------
RUNS__SERVICE__NAME=agent-runs
# Anything other than "dev" makes the startup check refuse the development credential below.
RUNS__SERVICE__ENVIRONMENT=dev
RUNS__SERVICE__HOST=0.0.0.0
RUNS__SERVICE__PORT=8090

# Every request is authenticated, in every environment. A key is not a password that unlocks
# the service — it *is* the caller, and it names the one tenant it may speak for, because
# X-Tenant-Id arrives in attacker-controlled bytes and cannot be authority on its own.
# Issue real keys outside dev; leaving "dev-key" in place makes startup fail.
# The tenant here must also exist in agent-schedules' credentials, or a fired schedule
# gets a 403 from this service that reads like a scheduling bug.
RUNS__SERVICE__API_KEYS={"dev-key": {"tenant_id": "acme", "name": "local development"}}

# --- database ----------------------------------------------------------------------------
RUNS__DATABASE__URL=postgresql+psycopg://memory:memory@localhost:5432/agent_runs
RUNS__DATABASE__POOL_SIZE=10
# Logs every statement. Useful when a query surprises you, far too loud for anything else.
RUNS__DATABASE__ECHO=false

# --- webhooks: telling a UI a run paused or finished -----------------------------------
# A person who starts a run at 9am and a schedule that fires at 3am have the same problem:
# something happens later and nobody is watching. Delivery is at-least-once and off the
# request path; the run row stays the source of truth, so a client that missed one
# reconciles by reading the run.
RUNS__WEBHOOKS__ENABLED=true
RUNS__WEBHOOKS__TIMEOUT_SECONDS=10.0
# Attempts per notification, including the first. Each failure waits backoff * 2**attempt.
RUNS__WEBHOOKS__MAX_ATTEMPTS=4
RUNS__WEBHOOKS__BACKOFF_SECONDS=1.0
# Signs the body as X-Run-Signature: sha256=<hex>. Empty means unsigned, which is only
# defensible on a laptop — startup refuses it outside dev, because an unsigned notification
# carries a run's output to whoever holds the URL.
RUNS__WEBHOOKS__SIGNING_SECRET=
# Plain http is allowed in dev and nowhere else.
RUNS__WEBHOOKS__ALLOWED_SCHEMES=["https","http"]

# --- observability -----------------------------------------------------------------------
RUNS__OBSERVABILITY__LOG_LEVEL=INFO
# false gives the human-readable console renderer; use it on a laptop, never in production.
RUNS__OBSERVABILITY__LOG_JSON=true
# Export stays off until an endpoint is given: a service exporting to nowhere spends its
# startup retrying a connection that will never succeed. Enabling without an endpoint is
# refused at startup rather than ignored.
RUNS__OBSERVABILITY__OTEL_ENABLED=false
# RUNS__OBSERVABILITY__OTEL_ENDPOINT=http://localhost:4317
