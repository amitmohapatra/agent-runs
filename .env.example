# agent-runs configuration: every variable the service, the ticker, compose and the test
# suite read. Service settings use one prefix, RUNS__, with __ between levels. Everything
# else (lease bounds, tick interval, retry policy, limits) is a constant in
# src/agent_runs/config/constants.py. Copy to .env; never commit .env.

# --- service (API) -------------------------------------------------------------------------
# Where uvicorn binds.
RUNS__SERVICE__HOST=0.0.0.0
RUNS__SERVICE__PORT=8090
# "dev" also accepts plain-http webhook URLs (a receiver on a laptop); anything else only https.
# Only "dev" and "test" may use the filesystem blob store; any other environment needs gcs.
RUNS__SERVICE__ENVIRONMENT=dev
# Uvicorn worker processes. Unset: one per CPU, at least 1 and at most 8. Each worker keeps
# its own key cache, rate-limit buckets and metrics.
# RUNS__SERVICE__WORKERS=4
# On SIGTERM, seconds the requests in flight may take to finish before they are closed.
RUNS__SERVICE__GRACEFUL_SHUTDOWN_SECONDS=20

# --- memory service (API) ---------------------------------------------------------------
# The key registry: every X-API-Key is introspected at {url}/v1/keys/self. Unset, the
# platform-wide MEMORY_URL is used (the harness and the memory SDK read it too), else
# http://localhost:8080.
RUNS__MEMORY__URL=http://localhost:8080
# MEMORY_URL=http://localhost:8080

# --- database (API, ticker, alembic) ----------------------------------------------------
RUNS__DATABASE__URL=postgresql+psycopg://memory:memory@localhost:5432/agent_runs
# Connections per process (per uvicorn worker), and how many more a burst may open.
RUNS__DATABASE__POOL_SIZE=10
RUNS__DATABASE__MAX_OVERFLOW=10
# Seconds a request waits for a pooled connection before a 503.
RUNS__DATABASE__POOL_TIMEOUT_SECONDS=5
# A pooled connection older than this many seconds is replaced: keep it under the idle
# timeout of anything between the service and PostgreSQL (a proxy, a load balancer).
RUNS__DATABASE__POOL_RECYCLE_SECONDS=300
# Test a pooled connection on checkout, so one the server closed is replaced, not used.
RUNS__DATABASE__POOL_PRE_PING=true
# Seconds to open a connection.
RUNS__DATABASE__CONNECT_TIMEOUT_SECONDS=5
# PostgreSQL cancels a statement past this many milliseconds (a 503 here); 0 = no limit.
RUNS__DATABASE__STATEMENT_TIMEOUT_MS=15000

# --- blob storage (API, ticker) -------------------------------------------------------
# Where run artifacts' bytes live: "filesystem" (default; dev and test only) or "gcs".
RUNS__BLOB__PROVIDER=filesystem
# filesystem: the directory; the API and the ticker must share it (compose mounts a volume).
RUNS__BLOB__ROOT=./.blob
# gcs: the bucket (required with gcs). Credentials are Application Default Credentials.
# RUNS__BLOB__BUCKET=trellis-run-artifacts
# gcs: point the Google client at an emulator instead of Google (read by google-cloud-storage).
# STORAGE_EMULATOR_HOST=http://127.0.0.1:4443

# --- ticker ---------------------------------------------------------------------------
# The file the ticker touches every tick and `python -m agent_runs.heartbeat` probes; one per
# ticker. Unset: a per-process file in the temp directory (and nothing for the probe to read).
# RUNS__TICKER__HEARTBEAT_FILE=/tmp/agent-runs-ticker.heartbeat

# --- observability ----------------------------------------------------------------------
RUNS__OBSERVABILITY__LOG_LEVEL=INFO
# false = the human-readable console renderer, for a laptop.
RUNS__OBSERVABILITY__LOG_JSON=true

# --- docker compose (host ports only) ---------------------------------------------------
# Host port the API is published on.
RUNS_PORT=8090
# Host port the compose PostgreSQL is published on.
RUNS_DB_PORT=5442

# --- tests ------------------------------------------------------------------------------
# Admin connection used to drop and recreate the test database.
RUNS_TEST_ADMIN_URL=postgresql://memory:memory@localhost:5432/postgres
# The test database (dropped and recreated on every run; never point it at real data).
RUNS_TEST_DB=agent_runs_tests
# 1 = also test the GCS adapter against a fake GCS server the suite starts in Docker.
# RUNS_TEST_GCS=1
